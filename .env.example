# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Cow Fresh POS"

# Deployment Environment
NODE_ENV=development

# WhatsApp Integration (Green API Cloud - No Docker, Zero Local Maintenance)
# Set to true once you paste your Green-API credentials
WHATSAPP_ENABLED=true
GREEN_API_ID_INSTANCE=your_green_api_id_instance
GREEN_API_TOKEN_INSTANCE=your_green_api_token_instance
GREEN_API_URL=https://api.green-api.com

# OpenRouteService (Optional: for live road route optimization)
NEXT_PUBLIC_ORS_API_KEY=
